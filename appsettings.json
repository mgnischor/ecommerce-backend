{
    "ConnectionStrings": {
        "DefaultConnection": ""
    },

    "Jwt": {
        "SecretKey": "",
        "Issuer": "ECommerceBackend",
        "Audience": "ECommerceClient",
        "ExpirationMinutes": "60"
    },

    "Cors": {
        "AllowedOrigins": ""
    },

    "Admin": {
        "SeedEnabled": false,
        "Email": "",
        "Password": ""
    },

    "Database": {
        "AutoMigrate": false
    },

    "Certificates": {
        "Enabled": false,
        "Path": "certs/ecommerce.pfx",
        "Password": "",
        "Host": "localhost",
        "DaysValid": 365,
        "HttpPort": 80,
        "HttpsPort": 8443
    },

    "Backup": {
        "Enabled": false,
        "IntervalHours": 24,
        "Directory": "backups",
        "RetentionDays": 7,
        "PgDumpPath": "pg_dump",
        "PgRestorePath": "pg_restore"
    },

    "Waf": {
        "Enabled": true,
        "MaxRequestBodySizeBytes": 10485760,
        "BlockedIpAddresses": "",
        "BlockedUserAgents": ""
    },

    "OpenTelemetry": {
        "ServiceName": "ECommerce.Backend",
        "ServiceVersion": "0.1.24",
        "EnableConsoleExporter": false,
        "OtlpEndpoint": ""
    },

    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning",
            "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
            "ECommerce.API": "Information",
            "ECommerce.Application": "Information",
            "ECommerce.Infrastructure": "Information"
        },
        "Console": {
            "IncludeScopes": true,
            "TimestampFormat": "yyyy-MM-dd HH:mm:ss ",
            "LogLevel": {
                "Default": "Information",
                "Microsoft.AspNetCore": "Warning"
            }
        },
        "Debug": {
            "LogLevel": {
                "Default": "Information"
            }
        }
    },
    "AllowedHosts": "*"
}
